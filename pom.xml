<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator only: builds every module in one reactor and lets IDEs import them all.
  Deliberately not a parent. The service inherits Spring Boot's dependency management and the
  Keycloak extensions must compile against Keycloak's own versions, so neither should inherit the other's.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.alensi</groupId>
    <artifactId>alensi-identity-build</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>alensi-identity (build)</name>

    <modules>
        <module>service</module>
        <module>keycloak/extensions</module>
        <module>client</module>
    </modules>
</project>
